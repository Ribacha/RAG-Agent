# 复制为项目根目录的 .env 后填写；CLI 会自动读取这个文件。
# Shell 中已 export 的同名变量优先于 .env，命令行 --llm-* 参数优先级最高。
# ingest、search 和 ask --dry-run 默认都可以离线运行，不需要 Key。
# 只有 ask（非 dry-run）和 agent 需要聊天模型 Key。
LLM_API_KEY=sk-你的DeepSeekKey
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Embedding 与聊天模型分开配置。默认 hash 是本地离线基线。
EMBEDDING_PROVIDER=hash
# 只有确认服务提供 /embeddings 时才填写下面三项。
# EMBEDDING_API_KEY=你的EmbeddingKey
# EMBEDDING_BASE_URL=https://你的服务/v1
# EMBEDDING_MODEL=你的embedding模型
